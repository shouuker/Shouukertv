class ProxyHandler(BaseHTTPRequestHandler):
    def log_message(self, *a): pass

    def do_GET(self):
        if self.path == "/playlist.m3u8":
            lines = ["#EXTM3U"]
            for path in STREAMS:
                cid = path.split("/")[-1]
                lines.append(f"#EXTINF:-1,Canal {cid}")
                lines.append(f"http://192.168.1.57:9191{path}")
            data = "\n".join(lines).encode()
            self.send_response(200)
            self.send_header("Content-Type", "application/vnd.apple.mpegurl")
            self.send_header("Access-Control-Allow-Origin", "*")
            self.end_headers()
            self.wfile.write(data)
            return
        if self.path in STREAMS:
            try:
                target_url = STREAMS[self.path]
                # Detectar el dominio origen según la URL del stream
                import urllib.parse as _up
                origin_host = _up.urlparse(target_url).netloc
                # Headers que imitan un navegador real (evita 403 en CDNs estrictos)
                headers = {
                    "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36",
                    "Referer":    "https://joy.cablevideo.com/",
                    "Origin":     "https://joy.cablevideo.com",
                    "Accept":     "*/*",
                    "Accept-Language": "es-ES,es;q=0.9",
                    "Connection": "keep-alive",
                    "Sec-Fetch-Dest": "empty",
                    "Sec-Fetch-Mode": "cors",
                    "Sec-Fetch-Site": "cross-site",
                }
                req = urllib.request.Request(target_url, headers=headers)
                with urllib.request.urlopen(req, timeout=15) as r:
                    data  = r.read()
                    ctype = r.headers.get("Content-Type", "application/vnd.apple.mpegurl")
                self.send_response(200)
                self.send_header("Content-Type", ctype)
                self.send_header("Access-Control-Allow-Origin", "*")
                self.end_headers()
                self.wfile.write(data)
            except Exception as e:
                code = 403 if "403" in str(e) else 502
                self.send_response(code)
                self.end_headers()
                self.wfile.write(f"Error {code}: {e}".encode())
            return
        self.send_response(404)
        self.end_headers()

    def do_POST(self):
        route = self.path.replace("/update/", "/stream/")
        if route in STREAMS:
            length = int(self.headers.get("Content-Length", 0))
            STREAMS[route] = self.rfile.read(length).decode().strip()
            self.send_response(200)
            self.end_headers()
            self.wfile.write(b"OK")
        else:
            self.send_response(404)
            self.end_headers()

