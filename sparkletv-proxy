import urllib.request
from http.server import HTTPServer, BaseHTTPRequestHandler

PORT = 9191

STREAMS = {
    "/stream/1": "https://pecdl1.streameasthd.net/espnpremium/tracks-v1a1/mono.m3u8?ip=179.37.214.240&token=028a66a0746296a2c180f9932797ef76771d8692-24-1778580446-1778526446",  # ESPN Premium
    "/stream/2": "https://joy.media.edge-apps.net/hls/d6urkAijE1xXeKYAXMz8IAaoKOJA-YkUQd2Zykeg-ga381BdtvpF_EDOJSijhPZmrMRFOxEC5dTS3U6YvYvuU5TORMx6umrvF4wPHw/hg35c-k15n6-nn351-lje0m_720p/index.m3u8",  # Joy Media HD
    "/stream/1778732918755": "https://joy.media.edge-apps.net/hls/xDuFJqb1sakA74kODbzBktP0t40vdy3D6-2k75dSqauI4jpBGYRmZqtfGZqj3Ab5Tv1ZkmaQ_3ydto9tdIXwlOXypbfv0uzeMt4Gxw/56cl9-6dffj-hb9op-hik52_1080p/index.m3u8",  # Jh
}

class ProxyHandler(BaseHTTPRequestHandler):
    def log_message(self, *a): pass

    def do_GET(self):
        if self.path == "/playlist.m3u8":
            lines = ["#EXTM3U"]
            for path in STREAMS:
                cid = path.split("/")[-1]
                lines.append(f"#EXTINF:-1,Canal {cid}")
                lines.append(f"http://localhost:9191{path}")
            data = "\n".join(lines).encode()
            self.send_response(200)
            self.send_header("Content-Type", "application/vnd.apple.mpegurl")
            self.send_header("Access-Control-Allow-Origin", "*")
            self.end_headers()
            self.wfile.write(data)
            return
        if self.path in STREAMS:
            try:
                target_url = STREAMS[self.path]
                # Detectar el dominio origen según la URL del stream
                import urllib.parse as _up
                origin_host = _up.urlparse(target_url).netloc
                # Headers que imitan un navegador real (evita 403 en CDNs estrictos)
                headers = {
                    "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36",
                    "Referer":    "https://joy.cablevideo.com/",
                    "Origin":     "https://joy.cablevideo.com",
                    "Accept":     "*/*",
                    "Accept-Language": "es-ES,es;q=0.9",
                    "Connection": "keep-alive",
                    "Sec-Fetch-Dest": "empty",
                    "Sec-Fetch-Mode": "cors",
                    "Sec-Fetch-Site": "cross-site",
                }
                req = urllib.request.Request(target_url, headers=headers)
                with urllib.request.urlopen(req, timeout=15) as r:
                    data  = r.read()
                    ctype = r.headers.get("Content-Type", "application/vnd.apple.mpegurl")
                self.send_response(200)
                self.send_header("Content-Type", ctype)
                self.send_header("Access-Control-Allow-Origin", "*")
                self.end_headers()
                self.wfile.write(data)
            except Exception as e:
                code = 403 if "403" in str(e) else 502
                self.send_response(code)
                self.end_headers()
                self.wfile.write(f"Error {code}: {e}".encode())
            return
        self.send_response(404)
        self.end_headers()

    def do_POST(self):
        route = self.path.replace("/update/", "/stream/")
        if route in STREAMS:
            length = int(self.headers.get("Content-Length", 0))
            STREAMS[route] = self.rfile.read(length).decode().strip()
            self.send_response(200)
            self.end_headers()
            self.wfile.write(b"OK")
        else:
            self.send_response(404)
            self.end_headers()

if __name__ == "__main__":
    server = HTTPServer(("0.0.0.0", PORT), ProxyHandler)
    print(f"\n  Proxy activo → http://localhost:{port}")
    print(f"  Playlist    → http://localhost:{port}/playlist.m3u8\n")
    for path in STREAMS:
        print(f"  Stream: http://localhost:{port}{path}")
    print("\n  Actualizar token en caliente:")
    print("    curl -X POST http://localhost:9191/update/1 -d 'NUEVA_URL'")
    print("    curl -X POST http://localhost:9191/update/2 -d 'NUEVA_URL'")
    print("    curl -X POST http://localhost:9191/update/1778732918755 -d 'NUEVA_URL'")
    print()
    server.serve_forever()